<Window x:Class="HelpDesk.Views.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Редактирование заявки"
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

	<Grid Margin="25">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Заголовок -->
		<TextBlock Grid.Row="0"
                   Text="Редактирование заявки"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

		<!-- Номер заявки -->
		<TextBlock x:Name="TicketNumberTextBlock"
                   Grid.Row="1"
                   Text="Заявка №: 0"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

		<!-- Категория -->
		<TextBlock Grid.Row="2" Text="Категория" Margin="0,0,0,4"/>
		<ComboBox x:Name="CategoryComboBox"
                  Grid.Row="3"
                  Height="34"
                  FontSize="14"
                  Margin="0,0,0,12">
			<ComboBoxItem Content="Оборудование"/>
			<ComboBoxItem Content="Программное обеспечение"/>
			<ComboBoxItem Content="ПО"/>
			<ComboBoxItem Content="Сеть"/>
			<ComboBoxItem Content="Учётная запись"/>
			<ComboBoxItem Content="Периферия"/>
			<ComboBoxItem Content="Другое"/>
		</ComboBox>

		<!-- Описание -->
		<TextBlock Grid.Row="4" Text="Описание" Margin="0,0,0,4"/>
		<TextBox x:Name="DescriptionTextBox"
                 Grid.Row="5"
                 FontSize="14"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Padding="5"
                 Margin="0,0,0,12"/>

		<!-- Приоритет -->
		<TextBlock Grid.Row="6" Text="Приоритет" Margin="0,0,0,4"/>
		<ComboBox x:Name="PriorityComboBox"
                  Grid.Row="7"
                  Height="34"
                  FontSize="14"
                  Margin="0,0,0,12">
			<ComboBoxItem Content="Низкий"/>
			<ComboBoxItem Content="Средний"/>
			<ComboBoxItem Content="Высокий"/>
		</ComboBox>

		<!-- Статус -->
		<TextBlock Grid.Row="8" Text="Статус" Margin="0,0,0,4"/>
		<ComboBox x:Name="StatusComboBox"
                  Grid.Row="9"
                  Height="34"
                  FontSize="14"
                  Margin="0,0,0,20">
			<ComboBoxItem Content="Новая"/>
			<ComboBoxItem Content="В работе"/>
			<ComboBoxItem Content="Выполнена"/>
			<ComboBoxItem Content="Отклонена"/>
		</ComboBox>

		<!-- Кнопки -->
		<StackPanel Grid.Row="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
			<Button x:Name="SaveChangesButton"
                    Content="Сохранить изменения"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveChangesButton_Click"/>
			<Button x:Name="CancelButton"
                    Content="Отмена"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CancelButton_Click"/>
		</StackPanel>
	</Grid>
</Window>

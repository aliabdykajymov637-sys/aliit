<Window x:Class="HelpDesk.Views.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Заявки"
        Height="600" Width="950"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="15"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="15"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="15"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 1. Верхняя панель -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<TextBlock Text="HelpDesk"
                           FontSize="26"
                           FontWeight="Bold"/>
				<TextBlock Text="Система обработки заявок"
                           FontSize="14"
                           Opacity="0.7"
                           Margin="0,4,0,0"/>
			</StackPanel>

			<StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
				<TextBlock x:Name="CurrentUserTextBlock"
                           Text="Пользователь: admin"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>
				<Button x:Name="LogoutButton"
                        Content="Выйти"
                        Height="32"
                        Padding="12,0"
                        Cursor="Hand"
                        Click="LogoutButton_Click"/>
			</StackPanel>
		</Grid>

		<!-- 2. Панель поиска и фильтрации -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="10"/>
				<ColumnDefinition Width="170"/>
				<ColumnDefinition Width="10"/>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="10"/>
				<ColumnDefinition Width="120"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<TextBlock Text="Поиск" Margin="0,0,0,5"/>
				<TextBox x:Name="SearchTextBox"
                         Height="32"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"/>
			</StackPanel>

			<StackPanel Grid.Column="2">
				<TextBlock Text="Статус" Margin="0,0,0,5"/>
				<ComboBox x:Name="StatusComboBox"
                          Height="32"
                          FontSize="14"
                          SelectedIndex="0"
                          SelectionChanged="StatusComboBox_SelectionChanged">
					<ComboBoxItem Content="Все"/>
					<ComboBoxItem Content="Новая"/>
					<ComboBoxItem Content="В работе"/>
					<ComboBoxItem Content="Выполнена"/>
					<ComboBoxItem Content="Отклонена"/>
				</ComboBox>
			</StackPanel>

			<Button x:Name="SearchButton"
                    Grid.Column="4"
                    Content="Найти"
                    Height="32"
                    Cursor="Hand"
                    VerticalAlignment="Bottom"
                    Click="SearchButton_Click"/>

			<Button x:Name="ResetFilterButton"
                    Grid.Column="6"
                    Content="Сбросить"
                    Height="32"
                    Cursor="Hand"
                    VerticalAlignment="Bottom"
                    Click="ResetFilterButton_Click"/>
		</Grid>

		<!-- 3. Таблица заявок -->
		<DataGrid x:Name="TicketsDataGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  MouseDoubleClick="TicketsDataGrid_MouseDoubleClick">
			<DataGrid.Columns>
				<DataGridTextColumn Header="№"
                                    Binding="{Binding Id}"
                                    Width="60"/>
				<DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category}"
                                    Width="140"/>
				<DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="*"/>
				<DataGridTextColumn Header="Приоритет"
                                    Binding="{Binding Priority}"
                                    Width="110"/>
				<DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="120"/>
				<DataGridTextColumn Header="Дата"
                                    Binding="{Binding CreatedAt}"
                                    Width="150"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- 4. Нижняя панель кнопок -->
		<StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
			<Button x:Name="AddTicketButton"
                    Content="Добавить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="AddTicketButton_Click"/>
			<Button x:Name="EditTicketButton"
                    Content="Редактировать"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="EditTicketButton_Click"/>
			<Button x:Name="DeleteTicketButton"
                    Content="Удалить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="DeleteTicketButton_Click"/>
		</StackPanel>
	</Grid>
</Window>
